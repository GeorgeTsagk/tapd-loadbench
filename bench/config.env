# Tunables for one epoch. Changing these breaks comparability with prior
# epochs, so record the change: bump SCHEMA_NOTE and note it in the commit.
#
# v2 is the tapd-main series. It is not comparable with the v1 series, which
# ran tapd v0.8.1 and is frozen in data/baseline-v081.jsonl: the version
# changed, the network was rebuilt from block zero, and the profiling export
# grew. Compare v1 against v2 at equal epoch numbers, never across the seam.
SCHEMA_NOTE="v3"

# --- version under test ---
#
# Pinned to a commit rather than tracking main. If every epoch rebuilt from
# whatever main happened to be, an upstream regression would be
# indistinguishable from a growth effect and the series would stop measuring
# growth. Re-pin deliberately, and bump SCHEMA_NOTE when doing so.
#
# 9cbf40a6 is main as of 2026-08-25 and is the first revision carrying all four
# fixes this series exists to observe, none of which are in any release tag:
#   bd692080  content-hash leaf diff        (#2187, fixes non-convergent sync)
#   37721264  batched witness/proof queries (#2251)
#   020de0a1  bounded input selection       (#2252)
#   9cbf40a6  cursor-based delta sync       (#2202)
# PR #2277, the encrypted asset wallet backup file. The backup case exists
# to exercise it, so the series runs the PR branch rather than main.
TAPD_REV=49f9d880
TAPD_IMAGE=tapd-backup-pprof:local

# --- profiling rates ---
#
# Read by the patched build at startup. Block profiling samples every blocking
# event that lasts at least this many nanoseconds and samples shorter ones
# proportionally, so 100us always captures database and network waits while
# ignoring scheduler noise. Mutex sampling keeps 1 in 100 contention events.
# Measured cost of both, plus an active CPU profile, is in
# bench/profiling-overhead.sh; set either to 0 to disable.
TAPD_BLOCK_PROFILE_RATE=100000
TAPD_MUTEX_PROFILE_FRACTION=100

# --- mint case ---
MINT_BATCH_SIZE=25
MINT_TOTAL_GROUPS=5
MINT_SUPPLY_MIN=100000
MINT_SUPPLY_MAX=500000

# --- send case ---
SEND_NUM_SENDS=10
SEND_NUM_ASSETS=1
SEND_ASSET_TYPE=normal
SEND_ADDR_VERSION=v2
# Sends in flight at once. Sequential sends measure one transfer at a time and
# cannot show contention between concurrent transfers, which is where the
# courier and the database compete.
SEND_CONCURRENCY=4
# Vary amount and address version across a batch, so a run covers both the v1
# and v2 paths rather than repeating one of them.
SEND_MIX=true

# --- burn case ---
#
# Its own case, not a step in minting. Burns leave zero-value outputs behind,
# which is what the orphan UTXO sweep in every funded send is looking for. With
# no burns anywhere that sweep scans everything and always finds nothing, so it
# was being measured in a state no real node is in. See tapd issue 2256.
BURN_NUM_BURNS=3
BURN_AMOUNT=1

# --- sync case ---
SYNC_TYPE=simplesyncer
SYNC_NUM_CLIENTS=8
SYNC_PAGE_SIZE=128

# --- timeouts ---
CASE_TIMEOUT=20m
SUITE_TIMEOUT=60m

# Stop the series at this many epochs. cron.sh removes its own crontab entry on
# reaching it, so the schedule stops firing rather than waking every 30 minutes
# to do nothing. Raise it and reinstall the entry to continue.
MAX_EPOCHS=400

# Cases to run, in order. Each is timed independently.
#
# Only the V2 cases and sync are usable here. The V1 "mint"/"send" cases and
# "multisig" reuse taproot-assets itest assertion helpers that assert on global
# counts (e.g. AssertAddrEvent requires exactly one address event), which holds
# only on a freshly created node. On a network that is never reset those counts
# grow every epoch, so those cases fail from epoch 2 onward. The V2 cases exist
# precisely because they assert less.
CASES="mintV2 burn sendV2 backup sync"

# Minimum on-chain balance (sats) a minter lnd must hold before an epoch.
MIN_LND_BALANCE=100000000

# Minimum number of separate confirmed outputs each lnd wallet must hold.
# Concurrent sends each anchor their own transaction and cannot share a coin,
# and change is unconfirmed within a batch, so this needs headroom over
# SEND_CONCURRENCY rather than merely matching it.
MIN_LND_UTXOS=20
